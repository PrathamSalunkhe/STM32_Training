#include "main.h"
#include "i2c_slave.h"
#include <stdio.h>

extern I2C_HandleTypeDef hi2c1;

#define RxSIZE 40U
uint8_t RxData[RxSIZE];

int32_t count = 0;

void process_data(void) {

	/* Parse for header , crc value , command , value */

	/*if header and crc value matches proceed further for commands */
	for (int i = 0; i < 40; i++) {
		printf("RxData %d - %x\r\n", i, RxData[i]);
	}

	/* Switch(command) // 0x01: led on/off (param : 0 off 1 on), 0x02: i2c addr change */
}

void HAL_I2C_ListenCpltCallback(I2C_HandleTypeDef *hi2c) {
	HAL_I2C_EnableListen_IT(&hi2c1);
}

void HAL_I2C_AddrCallback(I2C_HandleTypeDef *hi2c, uint8_t TransferDirection,
		uint16_t AddrMatchCode) {

	if (TransferDirection == I2C_DIRECTION_TRANSMIT) {
		count = 0;
		HAL_I2C_Slave_Sequential_Receive_IT(&hi2c1, RxData + count, 1,
		I2C_FIRST_FRAME);

	} else {
		Error_Handler();
	}
}

void HAL_I2C_SlaveRxCpltCallback(I2C_HandleTypeDef *hi2c) {

	count++;

	if (count < RxSIZE) {
		if (count == RxSIZE - 1) {
			HAL_I2C_Slave_Sequential_Receive_IT(&hi2c1, RxData + count, 1,
			I2C_LAST_FRAME);

		} else {
			HAL_I2C_Slave_Sequential_Receive_IT(&hi2c1, RxData + count, 1,
			I2C_LAST_FRAME);
		}
	}

	if (count == RxSIZE) {

		process_data();
		printf("The buffer has been filled.\r\n");
	}
}

void HAL_I2C_ErrorCallback(I2C_HandleTypeDef *hi2c) {

	uint32_t errorCode = HAL_I2C_GetError(&hi2c1);
	if (errorCode == 4) {
		process_data();
	}

	HAL_I2C_EnableListen_IT(&hi2c1);
}

